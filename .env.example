PORT=3017
PACKAGE_NAME=com.mukil.cally
MENTRAOS_API_KEY=replace_with_key_from_console

# Shared token for local OpenClaw skill -> app HTTP calls.
CALLY_MENTRA_CONTROL_TOKEN=change_me

# Optional: endpoint that receives glasses voice/photo/location context and returns {"reply":"..."}.
# This can later be an OpenClaw gateway route, a local bridge service, or another agent endpoint.
# When set, the webhook takes priority over the local CLI bridge below.
CALLY_AGENT_WEBHOOK_URL=
CALLY_AGENT_BEARER_TOKEN=

# Direct OpenAI fast path — PRIMARY low-latency glasses bridge (~1s vs ~15s for the
# full agent). Calls Chat Completions directly with a compressed digest of Cally's
# brain (see scripts/make-glasses-digest.mjs) as the system prompt. This is the
# latency/brain tradeoff: a fraction of the 150k context for a fraction of the latency.
CALLY_OPENAI_API_KEY=
CALLY_OPENAI_ENABLED=true
CALLY_OPENAI_MODEL=gpt-5.4-mini
CALLY_OPENAI_MAX_TOKENS=400
CALLY_OPENAI_TIMEOUT_MS=12000
# Compressed brain digest used as the system prompt. Regenerate with:
#   node scripts/make-glasses-digest.mjs
CALLY_OPENAI_DIGEST_PATH=
# Timezone for the local time/date fast-path.
CALLY_TIMEZONE=America/Los_Angeles

# Local OpenClaw CLI bridge: full-brain fallback when the fast path fails or is disabled.
# The app invokes the CLI directly (no shell) as:
#   openclaw agent --session-key <prefix>:<userId> --message <prompt> --json --timeout <seconds>
CALLY_AGENT_CLI_ENABLED=true
CALLY_AGENT_CLI_PATH=openclaw
CALLY_AGENT_CLI_TIMEOUT_SECONDS=45
CALLY_AGENT_SESSION_PREFIX=mentra
# Thinking level for the agent turn: off|minimal|low|medium|high|xhigh|adaptive|max.
# "minimal" keeps voice replies snappy; raise it for deeper reasoning + more latency.
CALLY_AGENT_CLI_THINKING=minimal
# Optional model override for the agent turn (provider/model or model id). Empty = gateway default.
CALLY_AGENT_CLI_MODEL=

# Where captured photos are written so the local agent bridge can reference them by path.
# Defaults to ../../data/mentra-captures relative to the app working directory.
CALLY_MENTRA_CAPTURE_DIR=

# Public HTTPS base URL the glasses can reach (no trailing slash), used to serve the
# wake-word acknowledgement chime. Without it, the chime is skipped (display cue still shows).
CALLY_PUBLIC_URL=https://mentra.example.com
# Play a short chime when the wake word ("Cally") is recognised. Set false to disable.
CALLY_ACK_SOUND=true
# Wake acknowledgement volume. Keep low; Mentra Live speaker makes bright chimes harsh.
CALLY_ACK_VOLUME=0.28
# Override the chime with any glasses-reachable audio URL (MP3 recommended).
# Defaults to <CALLY_PUBLIC_URL>/assets/cally-ack.mp3.
CALLY_ACK_SOUND_URL=

# Speech-to-text language. Use en-IN for Indian English, en-GB, es-ES, etc.
# Better-matched STT dramatically improves wake-word + command recognition for your accent.
CALLY_TRANSCRIBE_LANGUAGE=en-US
# Wake-word robustness: fuzzy phonetic matching for mis-heard pronunciations.
CALLY_WAKE_FUZZY=true
# Extra accepted spellings (comma-separated) if STT consistently hears something odd.
CALLY_WAKE_WORDS=

# If true, Cally reads replies out loud through MentraOS TTS.
CALLY_SPEAK_REPLIES=true

# Softer ElevenLabs/Mentra TTS profile. Voice ID can be changed after testing.
CALLY_TTS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
CALLY_TTS_MODEL_ID=eleven_flash_v2_5
CALLY_TTS_VOLUME=0.78
CALLY_TTS_STABILITY=0.72
CALLY_TTS_SIMILARITY=0.82
CALLY_TTS_STYLE=0.18
CALLY_TTS_SPEED=0.94
CALLY_TTS_SPEAKER_BOOST=false
