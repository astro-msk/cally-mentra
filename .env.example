PORT=3017
PACKAGE_NAME=com.mukil.cally
MENTRAOS_API_KEY=replace_with_key_from_console

# Shared token for local OpenClaw skill -> app HTTP calls.
CALLY_MENTRA_CONTROL_TOKEN=change_me

# Optional: endpoint that receives glasses voice/photo/location context and returns {"reply":"..."}.
# This can later be an OpenClaw gateway route, a local bridge service, or another agent endpoint.
# When set, the webhook takes priority over the local CLI bridge below.
CALLY_AGENT_WEBHOOK_URL=
CALLY_AGENT_BEARER_TOKEN=

# Local OpenClaw CLI bridge: used for full Cally reasoning when no webhook URL is set.
# The app invokes the CLI directly (no shell) as:
#   openclaw agent --session-key <prefix>:<userId> --message <prompt> --json --timeout <seconds>
CALLY_AGENT_CLI_ENABLED=true
CALLY_AGENT_CLI_PATH=openclaw
CALLY_AGENT_CLI_TIMEOUT_SECONDS=45
CALLY_AGENT_SESSION_PREFIX=mentra
# Thinking level for the agent turn: off|minimal|low|medium|high|xhigh|adaptive|max.
# "minimal" keeps voice replies snappy; raise it for deeper reasoning + more latency.
CALLY_AGENT_CLI_THINKING=minimal
# Optional model override for the agent turn (provider/model or model id). Empty = gateway default.
CALLY_AGENT_CLI_MODEL=

# Where captured photos are written so the local agent bridge can reference them by path.
# Defaults to ../../data/mentra-captures relative to the app working directory.
CALLY_MENTRA_CAPTURE_DIR=

# Public HTTPS base URL the glasses can reach (no trailing slash), used to serve the
# wake-word acknowledgement chime. Without it, the chime is skipped (display cue still shows).
CALLY_PUBLIC_URL=https://mentra.example.com
# Play a short chime the instant the wake word ("Cally") is heard. Set false to disable.
CALLY_ACK_SOUND=true

# If true, Cally reads replies out loud through MentraOS TTS.
CALLY_SPEAK_REPLIES=true
