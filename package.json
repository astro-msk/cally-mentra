{
  "name": "cally-mentra",
  "version": "1.0.0",
  "description": "Cally voice/vision bridge for MentraOS smart glasses.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "losefit": "tsx src/losefit-cli.ts",
    "start": "node dist/index.js",
    "smoke:losefit": "tsx src/losefit-cli.ts smoke --path /tmp/cally-losefit-smoke.jsonl",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@mentra/sdk": "^2.1.29",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
